# Postgres (Coolify: crie um banco PostgreSQL e use a URL interna)
DATABASE_URL="postgresql://sintonia:senha@localhost:5432/sintonia?schema=public"

# Clerk (dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Resend (resend.com). O domínio do RESEND_FROM precisa estar verificado
RESEND_API_KEY=
RESEND_FROM="Sintonia <oi@seudominio.com>"

# URL pública e segredo do cron
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=troque-por-um-segredo-longo

# Admins do painel (/admin): e-mails separados por vírgula, iguais aos da conta no Clerk
ADMIN_EMAILS=voce@seudominio.com
